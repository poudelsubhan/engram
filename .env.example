# Atlas Hackathon Sandbox cluster. Needs readWrite on `engram` and read on `sample_mflix`.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Model gateway for the main agent (Claude Sonnet).
OPENROUTER_API_KEY=

# Metabolism tier: the small fast model on the memory write path.
FIREWORKS_API_KEY=

# Optional. Preferred embedding provider; falls back to Fireworks embeddings.
VOYAGE_API_KEY=

# Optional overrides
# ENGRAM_EMBED_PROVIDER=voyage|fireworks|auto
# ENGRAM_MAIN_MODEL=anthropic/claude-sonnet-5
# ENGRAM_SMALL_MODEL=accounts/fireworks/models/deepseek-v4-flash
